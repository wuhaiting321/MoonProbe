// The cli package is the executable entry point: it reads a `.probe` file,
// parses it, executes every case through the runner and prints the report.

import {
  "wuhaiting321/moonprobe/parser",
  "wuhaiting321/moonprobe/runner",
  "wuhaiting321/moonprobe/reporter",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")
